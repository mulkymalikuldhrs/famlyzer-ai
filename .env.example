# ═══════════════════════════════════════════
# Famlyzer AI - Environment Variables
# Copy this file to .env and fill in the values
# ═══════════════════════════════════════════

# ── Database (PostgreSQL required for production) ──
DATABASE_URL="postgresql://user:password@localhost:5432/famlyzer_ai?schema=public"

# ── NextAuth.js ──
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ── Stripe Payment Integration ──
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Stripe Price IDs ──
STRIPE_PRO_MONTHLY_PRICE_ID="price_..."
STRIPE_PRO_YEARLY_PRICE_ID="price_..."
STRIPE_BUSINESS_MONTHLY_PRICE_ID="price_..."
STRIPE_BUSINESS_YEARLY_PRICE_ID="price_..."

# ── Node Environment ──
NODE_ENV="development"

# ── AI SDK (handled by z-ai-web-dev-sdk) ──
# ZAI_API_KEY=your_key_here

# ── Optional: Redis for rate limiting (production) ──
# REDIS_URL="redis://localhost:6379"

# ── Optional: S3-compatible storage for vault files ──
# S3_ENDPOINT="https://s3.amazonaws.com"
# S3_ACCESS_KEY="..."
# S3_SECRET_KEY="..."
# S3_BUCKET="famlyzer-vault"
